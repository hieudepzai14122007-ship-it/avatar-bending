<!-- The waystone left in the world. It marks a spot to return to and fades after two minutes. -->
<Entity tags="elemental_arts_waystone" >

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/waystone.xml"
		next_rect_animation=""
		rect_animation=""
		z_index="1.1"
		>
	</SpriteComponent>

	<ParticleEmitterComponent
		emitted_material_name="spark_yellow"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-4"
		x_pos_offset_max="4"
		y_pos_offset_min="-5"
		y_pos_offset_max="5"
		x_vel_min="-4"
		x_vel_max="4"
		y_vel_min="-30"
		y_vel_max="-10"
		gravity.y="0.0"
		count_min="1"
		count_max="1"
		lifetime_min="0.4"
		lifetime_max="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="4"
		emission_interval_max_frames="9"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="60"
		r="230"
		g="200"
		b="120" >
	</LightComponent>

	<!-- Who placed it: "player", or the entity id of another caster. -->
	<VariableStorageComponent
		name="owner"
		value_string=""
		>
	</VariableStorageComponent>

	<LifetimeComponent
		lifetime="7200" >
	</LifetimeComponent>

</Entity>
