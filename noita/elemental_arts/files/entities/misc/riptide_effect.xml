<!-- Attached to an enemy hit by Riptide: the current that drags it to the player. -->
<Entity>

	<InheritTransformComponent
		_enabled="1" >
	</InheritTransformComponent>

	<!-- Keeps the current on its victim for 0.8 seconds, then removes it. -->
	<GameEffectComponent
		effect="CUSTOM"
		custom_effect_id="ELEMENTAL_ARTS_RIPTIDE"
		frames="48"
		>
	</GameEffectComponent>

	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/riptide.lua"
		execute_every_n_frame="1"
		>
	</LuaComponent>

	<ParticleEmitterComponent
		emitted_material_name="spark_blue"
		gravity.y="0.0"
		lifetime_min="0.2"
		lifetime_max="0.5"
		count_min="2"
		count_max="3"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		area_circle_radius.min="6"
		area_circle_radius.max="10"
		cosmetic_force_create="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- In case the effect is not cleaned up for any reason, the pull still ends. -->
	<LifetimeComponent
		lifetime="52" >
	</LifetimeComponent>

</Entity>
