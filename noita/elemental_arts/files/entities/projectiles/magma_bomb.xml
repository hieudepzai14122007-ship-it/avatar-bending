<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="300"
			air_friction="0.4"
			mass="0.12"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.8"
		lob_max="1.0"
		speed_min="240"
		speed_max="280"
		direction_random_rad="0.01"
		die_on_low_velocity="1"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="1"
		lifetime="180"
		damage="0.4"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		ragdoll_force_multiplier="0.03"
		hit_particle_force_multiplier="0.2"
		damage_game_effect_entities="data/entities/misc/effect_apply_on_fire.xml,"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher_large.xml"
		shoot_light_flash_r="255"
		shoot_light_flash_g="120"
		shoot_light_flash_b="10"
		shoot_light_flash_radius="120"
		knockback_force="2.0"
		physics_impulse_coeff="3500"
		>
		<damage_by_type
			fire="0.4"
			>
		</damage_by_type>
		<!-- The rock cracks open and spills its molten core. -->
		<config_explosion
			never_cache="1"
			damage="1.2"
			camera_shake="9"
			explosion_radius="14"
			explosion_sprite="data/particles/explosion_032.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="30"
			create_cell_material="fire"
			hole_destroy_liquid="0"
			hole_enabled="1"
			ray_energy="60000"
			max_durability_to_destroy="8"
			load_this_entity="mods/elemental_arts/files/entities/projectiles/magma_bomb_splash.xml"
			particle_effect="1"
			damage_mortals="1"
			physics_explosion_power.min="0.8"
			physics_explosion_power.max="1.2"
			physics_throw_enabled="1"
			shake_vegetation="1"
			sparks_count_min="20"
			sparks_count_max="40"
			sparks_enabled="1"
			light_fade_time="0.8"
			stains_enabled="1"
			stains_radius="9" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/magma_bomb.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Smoke. -->
	<ParticleEmitterComponent
		emitted_material_name="smoke"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-1"
		x_pos_offset_max="1"
		y_pos_offset_min="-1"
		y_pos_offset_max="1"
		x_vel_min="-10"
		x_vel_max="10"
		y_vel_min="-10"
		y_vel_max="10"
		count_min="2"
		count_max="3"
		lifetime_min="0.1"
		lifetime_max="0.3"
		create_real_particles="1"
		emit_cosmetic_particles="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="2"
		delay_frames="3"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- Cosmetic embers. -->
	<ParticleEmitterComponent
		emitted_material_name="spark"
		offset.x="0"
		offset.y="0"
		gravity.y="-80.0"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="-2"
		y_pos_offset_max="2"
		x_vel_min="-12"
		x_vel_max="12"
		y_vel_min="-12"
		y_vel_max="12"
		count_min="1"
		count_max="3"
		lifetime_min="0.3"
		lifetime_max="0.8"
		is_trail="1"
		trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="100"
		r="255"
		g="130"
		b="30" >
	</LightComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_launcher">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/magma_bomb.xml"
		>
	</VariableStorageComponent>

</Entity>
