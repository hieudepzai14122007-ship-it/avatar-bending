<!-- One of the three embers that circle the caster. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="0"
			mass="0.04"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.8"
		lob_max="1.0"
		speed_min="0"
		speed_max="0"
		direction_random_rad="0"
		on_death_explode="0"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="0"
		explosion_dont_damage_shooter="1"
		on_collision_die="0"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		penetrate_entities="1"
		penetrate_world="1"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		lifetime="420"
		damage="0"
		damage_every_x_frames="10"
		ragdoll_force_multiplier="0.0"
		hit_particle_force_multiplier="0.1"
		camera_shake_when_shot="0.0"
		bounces_left="0"
		damage_game_effect_entities="data/entities/misc/effect_apply_on_fire.xml,"
		muzzle_flash_file=""
		shoot_light_flash_radius="1"
		knockback_force="0.5"
		physics_impulse_coeff="300"
		>
		<damage_by_type
			fire="0.24"
			>
		</damage_by_type>
		<config_explosion />
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/ember_halo.xml"
		next_rect_animation=""
		rect_animation=""
		additive="1"
		>
	</SpriteComponent>

	<!-- Keeps the ember circling its caster. -->
	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/ember_halo_ember.lua"
		execute_every_n_frame="1"
		>
	</LuaComponent>

	<!-- Where on the circle this ember sits, in radians. Set when it is lit. -->
	<VariableStorageComponent
		name="phase"
		value_float="0"
		>
	</VariableStorageComponent>

	<!-- Cosmetic sparks only: real fire this close would burn the caster. -->
	<ParticleEmitterComponent
		emitted_material_name="spark"
		offset.x="0"
		offset.y="0"
		gravity.y="-40.0"
		x_pos_offset_min="-1"
		x_pos_offset_max="1"
		y_pos_offset_min="-1"
		y_pos_offset_max="1"
		x_vel_min="-5"
		x_vel_max="5"
		y_vel_min="-5"
		y_vel_max="5"
		count_min="1"
		count_max="2"
		lifetime_min="0.15"
		lifetime_max="0.4"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="45"
		r="255"
		g="150"
		b="40" >
	</LightComponent>

</Entity>
