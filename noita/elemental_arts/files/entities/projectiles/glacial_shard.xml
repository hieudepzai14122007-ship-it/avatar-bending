<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="40"
			air_friction="0.2"
			mass="0.04"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.5"
		lob_max="0.7"
		speed_min="560"
		speed_max="660"
		direction_random_rad="0.01"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="0"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="0"
		lifetime="45"
		lifetime_randomness="6"
		damage="0"
		velocity_sets_scale="0"
		velocity_sets_rotation="1"
		ragdoll_force_multiplier="0.005"
		hit_particle_force_multiplier="0.1"
		damage_game_effect_entities="data/entities/misc/effect_frozen_short.xml,"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_magic_launcher_blue.xml"
		shoot_light_flash_r="10"
		shoot_light_flash_g="140"
		shoot_light_flash_b="255"
		shoot_light_flash_radius="64"
		knockback_force="1.0"
		physics_impulse_coeff="900"
		>
		<damage_by_type
			ice="0.3"
			>
		</damage_by_type>
		<!-- The shard just shatters: a puff of frost, no crater. -->
		<config_explosion
			never_cache="1"
			damage="0.0"
			camera_shake="0.5"
			explosion_radius="3"
			explosion_sprite="data/particles/explosion_008.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			spark_material="spark_blue"
			particle_effect="0"
			damage_mortals="0"
			physics_explosion_power.min="0.1"
			physics_explosion_power.max="0.2"
			physics_throw_enabled="1"
			shake_vegetation="1"
			sparks_count_min="6"
			sparks_count_max="10"
			sparks_enabled="1"
			material_sparks_enabled="0"
			light_enabled="0"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/glacial_shard.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Frost trail. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_blue"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-1"
		x_pos_offset_max="1"
		y_pos_offset_min="-1"
		y_pos_offset_max="1"
		x_vel_min="-4"
		x_vel_max="4"
		y_vel_min="-4"
		y_vel_max="4"
		gravity.y="20.0"
		count_min="1"
		count_max="2"
		lifetime_min="0.2"
		lifetime_max="0.6"
		is_trail="1"
		trail_gap="2.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="40"
		r="120"
		g="200"
		b="255" >
	</LightComponent>

	<!-- Freezes any kind of water the shard flies through or lands in. -->
	<MagicConvertMaterialComponent
		from_material_tag="[water]"
		to_material="ice_static"
		steps_per_frame="8"
		loop="1"
		is_circle="1"
		radius="6" >
	</MagicConvertMaterialComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_arrow">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/glacial_shard.xml"
		>
	</VariableStorageComponent>

</Entity>
