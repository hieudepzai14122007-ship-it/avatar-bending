<!-- Spawned where a Fire Pillar ember lands: a column of fire that burns for a while. -->
<Entity>

	<!-- Real fire thrown straight up. -->
	<ParticleEmitterComponent
		emitted_material_name="fire"
		offset.x="0"
		offset.y="-3"
		x_pos_offset_min="-4"
		x_pos_offset_max="4"
		y_pos_offset_min="-4"
		y_pos_offset_max="0"
		x_vel_min="-12"
		x_vel_max="12"
		y_vel_min="-230"
		y_vel_max="-90"
		gravity.y="0.0"
		count_min="5"
		count_max="7"
		lifetime_min="0.3"
		lifetime_max="0.7"
		create_real_particles="1"
		emit_cosmetic_particles="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- Cosmetic embers. -->
	<ParticleEmitterComponent
		emitted_material_name="spark"
		offset.x="0"
		offset.y="-3"
		x_pos_offset_min="-5"
		x_pos_offset_max="5"
		y_pos_offset_min="-4"
		y_pos_offset_max="0"
		x_vel_min="-20"
		x_vel_max="20"
		y_vel_min="-260"
		y_vel_max="-120"
		gravity.y="0.0"
		count_min="3"
		count_max="5"
		lifetime_min="0.2"
		lifetime_max="0.5"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- Burns enemies standing in the column. -->
	<AreaDamageComponent
		aabb_min.x="-9"
		aabb_min.y="-80"
		aabb_max.x="9"
		aabb_max.y="4"
		damage_per_frame="0.012"
		update_every_n_frame="1"
		entities_with_tag="enemy"
		damage_type="DAMAGE_FIRE"
		>
	</AreaDamageComponent>

	<LightComponent
		_enabled="1"
		radius="120"
		r="255"
		g="150"
		b="40" >
	</LightComponent>

	<LifetimeComponent
		lifetime="110" >
	</LifetimeComponent>

</Entity>
