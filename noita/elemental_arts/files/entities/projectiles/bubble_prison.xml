<!-- Bubble Prison: a drifting bubble that traps the first enemy it touches. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="-20"
			air_friction="0.8"
			mass="0.03"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.5"
		lob_max="0.7"
		speed_min="300"
		speed_max="340"
		direction_random_rad="0.02"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="0"
		lifetime="110"
		lifetime_randomness="8"
		damage="0.1"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		ragdoll_force_multiplier="0.0"
		hit_particle_force_multiplier="0.1"
		damage_game_effect_entities="mods/elemental_arts/files/entities/misc/bubble_prison_effect.xml,data/entities/misc/effect_apply_wet.xml,"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_magic_small.xml"
		shoot_light_flash_r="70"
		shoot_light_flash_g="190"
		shoot_light_flash_b="255"
		shoot_light_flash_radius="64"
		knockback_force="0.2"
		physics_impulse_coeff="300"
		>
		<!-- A harmless pop. -->
		<config_explosion
			never_cache="1"
			damage="0.0"
			camera_shake="0.5"
			explosion_radius="2"
			explosion_sprite="data/particles/explosion_016_plasma.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			spark_material="spark_blue"
			particle_effect="0"
			damage_mortals="0"
			physics_explosion_power.min="0"
			physics_explosion_power.max="0"
			physics_throw_enabled="0"
			shake_vegetation="1"
			sparks_count_min="6"
			sparks_count_max="10"
			sparks_enabled="1"
			material_sparks_enabled="0"
			light_enabled="0"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="0.85"
		image_file="mods/elemental_arts/files/projectiles_gfx/bubble_prison.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<ParticleEmitterComponent
		emitted_material_name="spark_blue"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-3"
		x_pos_offset_max="3"
		y_pos_offset_min="-3"
		y_pos_offset_max="3"
		x_vel_min="-5"
		x_vel_max="5"
		y_vel_min="-20"
		y_vel_max="-5"
		gravity.y="-20.0"
		count_min="1"
		count_max="1"
		lifetime_min="0.3"
		lifetime_max="0.7"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="2"
		emission_interval_max_frames="4"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="40"
		r="70"
		g="190"
		b="255" >
	</LightComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_bubble">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/bubble_prison.xml"
		>
	</VariableStorageComponent>

</Entity>
