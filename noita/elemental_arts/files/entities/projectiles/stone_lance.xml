<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="0"
			mass="0.1"
			>
		</VelocityComponent>
	</Base>

	<!-- Flies straight through creatures and terrain for a short distance. -->
	<ProjectileComponent
		_enabled="1"
		lob_min="0.8"
		lob_max="1.0"
		speed_min="180"
		speed_max="180"
		direction_random_rad="0"
		on_death_explode="0"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="0"
		explosion_dont_damage_shooter="1"
		on_collision_die="0"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		penetrate_entities="1"
		penetrate_world="1"
		penetrate_world_velocity_coeff="1"
		velocity_sets_scale="0"
		velocity_sets_rotation="1"
		lifetime="34"
		damage="0.6"
		damage_every_x_frames="5"
		ragdoll_force_multiplier="0.02"
		hit_particle_force_multiplier="0.1"
		camera_shake_when_shot="3.0"
		bounces_left="0"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher.xml"
		shoot_light_flash_r="200"
		shoot_light_flash_g="170"
		shoot_light_flash_b="110"
		shoot_light_flash_radius="64"
		knockback_force="2.5"
		physics_impulse_coeff="4000"
		>
		<config_explosion />
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/stone_lance.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- The stone itself: real, solid rock laid down along the flight path.
	     Starts a few frames late so the beam never forms on top of the caster. -->
	<ParticleEmitterComponent
		emitted_material_name="rock_static"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="-2"
		y_pos_offset_max="2"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		count_min="14"
		count_max="14"
		lifetime_min="0.1"
		lifetime_max="0.3"
		is_trail="1"
		trail_gap="1.0"
		create_real_particles="1"
		emit_cosmetic_particles="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		delay_frames="5"
		is_emitting="1"
		friction="0"
		render_on_grid="1"
		attractor_force="0"
		>
	</ParticleEmitterComponent>

	<!-- Cosmetic grit shaken off the growing beam. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_yellow"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-3"
		x_pos_offset_max="3"
		y_pos_offset_min="-3"
		y_pos_offset_max="3"
		x_vel_min="-30"
		x_vel_max="30"
		y_vel_min="-30"
		y_vel_max="30"
		gravity.y="120.0"
		count_min="1"
		count_max="3"
		lifetime_min="0.2"
		lifetime_max="0.5"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="40"
		r="200"
		g="170"
		b="110" >
	</LightComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/summon_pebble">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/stone_lance.xml"
		>
	</VariableStorageComponent>

</Entity>
