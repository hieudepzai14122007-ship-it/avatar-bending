<!-- Crescent Gale: a blade of wind that flies out, turns around and comes back. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="0"
			mass="0.04"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.5"
		lob_max="0.7"
		speed_min="380"
		speed_max="380"
		direction_random_rad="0.00"
		on_death_explode="0"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="0"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		penetrate_entities="1"
		bounces_left="4"
		bounce_always="1"
		bounce_at_any_angle="1"
		bounce_energy="1.0"
		lifetime="170"
		damage="0"
		damage_every_x_frames="6"
		velocity_sets_scale="0"
		velocity_sets_rotation="1"
		ragdoll_force_multiplier="0.01"
		hit_particle_force_multiplier="0.1"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_air.xml"
		shoot_light_flash_r="160"
		shoot_light_flash_g="200"
		shoot_light_flash_b="200"
		shoot_light_flash_radius="48"
		knockback_force="1.0"
		physics_impulse_coeff="800"
		>
		<damage_by_type
			slice="0.5"
			>
		</damage_by_type>
		<config_explosion />
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="0.9"
		image_file="mods/elemental_arts/files/projectiles_gfx/crescent_gale.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Turns the blade back towards whoever cast it. -->
	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/crescent_gale.lua"
		execute_every_n_frame="1"
		>
	</LuaComponent>

	<!-- How many frames it has been flying. -->
	<VariableStorageComponent
		name="age"
		value_int="0"
		>
	</VariableStorageComponent>

	<ParticleEmitterComponent
		emitted_material_name="spark_white"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="-2"
		y_pos_offset_max="2"
		x_vel_min="-6"
		x_vel_max="6"
		y_vel_min="-6"
		y_vel_max="6"
		gravity.y="0.0"
		count_min="1"
		count_max="2"
		lifetime_min="0.2"
		lifetime_max="0.5"
		is_trail="1"
		trail_gap="2.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_disc">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/crescent_gale.xml"
		>
	</VariableStorageComponent>

</Entity>
