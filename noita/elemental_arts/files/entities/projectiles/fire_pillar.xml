<!-- Fire Pillar: an ember that erupts into a column of fire where it lands. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="200"
			air_friction="0.3"
			mass="0.06"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.8"
		lob_max="1.0"
		speed_min="320"
		speed_max="360"
		direction_random_rad="0.01"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="1"
		lifetime="120"
		damage="0"
		velocity_sets_scale="0"
		velocity_sets_rotation="1"
		ragdoll_force_multiplier="0.01"
		hit_particle_force_multiplier="0.1"
		damage_game_effect_entities="data/entities/misc/effect_apply_on_fire.xml,"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher.xml"
		shoot_light_flash_r="255"
		shoot_light_flash_g="140"
		shoot_light_flash_b="10"
		shoot_light_flash_radius="96"
		knockback_force="1.0"
		physics_impulse_coeff="1500"
		>
		<damage_by_type
			fire="0.3"
			>
		</damage_by_type>
		<!-- A small pop that plants the pillar. No crater. -->
		<config_explosion
			never_cache="1"
			damage="0.2"
			camera_shake="3"
			explosion_radius="6"
			explosion_sprite="data/particles/explosion_016.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			load_this_entity="mods/elemental_arts/files/entities/projectiles/fire_pillar_column.xml"
			particle_effect="0"
			damage_mortals="1"
			physics_explosion_power.min="0.2"
			physics_explosion_power.max="0.4"
			physics_throw_enabled="1"
			shake_vegetation="1"
			sparks_count_min="8"
			sparks_count_max="14"
			sparks_enabled="1"
			light_fade_time="0.5"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/fire_pillar.xml"
		next_rect_animation=""
		rect_animation=""
		additive="1"
		>
	</SpriteComponent>

	<ParticleEmitterComponent
		emitted_material_name="spark"
		offset.x="0"
		offset.y="0"
		gravity.y="-60.0"
		x_pos_offset_min="-1"
		x_pos_offset_max="1"
		y_pos_offset_min="-1"
		y_pos_offset_max="1"
		x_vel_min="-6"
		x_vel_max="6"
		y_vel_min="-6"
		y_vel_max="6"
		count_min="1"
		count_max="2"
		lifetime_min="0.2"
		lifetime_max="0.6"
		is_trail="1"
		trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="70"
		r="255"
		g="150"
		b="40" >
	</LightComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_fire_heavy">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/fire_pillar.xml"
		>
	</VariableStorageComponent>

</Entity>
