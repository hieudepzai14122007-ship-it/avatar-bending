<!-- Updraft: stays where it was cast for a moment and blows the caster upwards. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			mass="0.04"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.8"
		lob_max="1.0"
		speed_min="0"
		speed_max="0"
		direction_random_rad="0"
		on_death_explode="0"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="0"
		explosion_dont_damage_shooter="1"
		on_collision_die="0"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		lifetime="16"
		damage="0"
		ragdoll_force_multiplier="0.0"
		hit_particle_force_multiplier="0.0"
		camera_shake_when_shot="0.0"
		bounces_left="0"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_air.xml"
		shoot_light_flash_radius="1"
		knockback_force="0.0"
		physics_impulse_coeff="0"
		penetrate_entities="1"
		penetrate_world="1"
		>
		<config_explosion />
	</ProjectileComponent>

	<!-- Lifts whoever cast the spell, once per frame while the gust lasts. -->
	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/updraft.lua"
		execute_every_n_frame="1"
		>
	</LuaComponent>

	<!-- A column of rising air. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_white"
		offset.x="0"
		offset.y="6"
		x_pos_offset_min="-9"
		x_pos_offset_max="9"
		y_pos_offset_min="-4"
		y_pos_offset_max="10"
		x_vel_min="-12"
		x_vel_max="12"
		y_vel_min="-260"
		y_vel_max="-140"
		gravity.y="0.0"
		count_min="4"
		count_max="7"
		lifetime_min="0.2"
		lifetime_max="0.6"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		draw_as_long="1"
		airflow_force="0.5"
		airflow_time="1.101"
		airflow_scale="0.05"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- Fans flames, like the vanilla burst of air. -->
	<MagicConvertMaterialComponent
		fan_the_flames="10"
		from_material=""
		to_material=""
		steps_per_frame="20"
		loop="1"
		is_circle="1"
		radius="12" >
	</MagicConvertMaterialComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_burst_of_air">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/updraft.xml"
		>
	</VariableStorageComponent>

</Entity>
