<!-- Avalanche: a snowball that gets bigger and hits harder the longer it rolls. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="250"
			air_friction="0.1"
			mass="0.08"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.5"
		lob_max="0.7"
		speed_min="260"
		speed_max="300"
		direction_random_rad="0.01"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="0"
		die_on_low_velocity="1"
		die_on_low_velocity_limit="20"
		bounces_left="6"
		bounce_always="1"
		bounce_energy="0.6"
		lifetime="300"
		damage="0.2"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		ragdoll_force_multiplier="0.02"
		hit_particle_force_multiplier="0.2"
		damage_game_effect_entities="data/entities/misc/effect_frozen_short.xml,"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_magic_launcher_blue.xml"
		shoot_light_flash_r="160"
		shoot_light_flash_g="210"
		shoot_light_flash_b="255"
		shoot_light_flash_radius="64"
		knockback_force="2.0"
		physics_impulse_coeff="2500"
		>
		<!-- Bursts into powder: a shove, no crater. -->
		<config_explosion
			never_cache="1"
			damage="0.0"
			camera_shake="2"
			explosion_radius="8"
			explosion_sprite="data/particles/explosion_040_poof_blue.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			spark_material="spark_white"
			particle_effect="0"
			damage_mortals="0"
			physics_explosion_power.min="0.6"
			physics_explosion_power.max="1.0"
			physics_throw_enabled="1"
			shake_vegetation="1"
			sparks_count_min="10"
			sparks_count_max="18"
			sparks_enabled="1"
			material_sparks_enabled="0"
			light_enabled="0"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/avalanche.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Makes it grow. -->
	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/avalanche.lua"
		execute_every_n_frame="4"
		>
	</LuaComponent>

	<!-- How many times it has grown so far. -->
	<VariableStorageComponent
		name="growth"
		value_int="0"
		>
	</VariableStorageComponent>

	<!-- Loose snow shed along the way. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_white"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="-2"
		y_pos_offset_max="2"
		x_vel_min="-10"
		x_vel_max="10"
		y_vel_min="-15"
		y_vel_max="5"
		gravity.y="80.0"
		count_min="1"
		count_max="2"
		lifetime_min="0.2"
		lifetime_max="0.6"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="2"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_bubble">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/avalanche.xml"
		>
	</VariableStorageComponent>

</Entity>
