<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="0"
			mass="0.05"
			>
		</VelocityComponent>
	</Base>

	<!-- The core: pierces creatures and cuts whatever the wind drags into it. -->
	<ProjectileComponent
		_enabled="1"
		lob_min="0.5"
		lob_max="0.7"
		speed_min="100"
		speed_max="120"
		direction_random_rad="0.00"
		on_death_explode="0"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="0"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		on_collision_remove_projectile="0"
		penetrate_entities="1"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		bounces_left="8"
		bounce_always="1"
		bounce_at_any_angle="1"
		bounce_energy="1.0"
		lifetime="170"
		lifetime_randomness="10"
		damage="0"
		damage_every_x_frames="8"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		ragdoll_force_multiplier="0.01"
		hit_particle_force_multiplier="0.1"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_air.xml"
		shoot_light_flash_r="160"
		shoot_light_flash_g="200"
		shoot_light_flash_b="200"
		shoot_light_flash_radius="48"
		knockback_force="0"
		physics_impulse_coeff="0"
		>
		<damage_by_type
			slice="0.14"
			>
		</damage_by_type>
		<config_explosion
			never_cache="1"
			damage="0.0"
			camera_shake="0.0"
			explosion_radius="0"
			explosion_sprite=""
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			particle_effect="0"
			damage_mortals="0"
			physics_explosion_power.min="0"
			physics_explosion_power.max="0"
			physics_throw_enabled="0"
			shake_vegetation="1"
			sparks_count_max="0"
			sparks_count_min="0"
			sparks_enabled="0"
			material_sparks_enabled="0"
			material_sparks_count_max="0"
			material_sparks_count_min="0"
			light_enabled="0"
			stains_enabled="0"
			stains_radius="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="0.85"
		image_file="mods/elemental_arts/files/projectiles_gfx/whirlwind.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Wind streaks being sucked towards the core. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_white"
		gravity.y="0.0"
		lifetime_min="0.4"
		lifetime_max="1.0"
		count_min="2"
		count_max="4"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		area_circle_radius.min="30"
		area_circle_radius.max="56"
		cosmetic_force_create="0"
		airflow_force="1.7"
		airflow_time="0.11"
		airflow_scale="0.05"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		attractor_force="6"
		draw_as_long="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- Dust thrown up out of the funnel. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_white"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-7"
		x_pos_offset_max="7"
		y_pos_offset_min="-12"
		y_pos_offset_max="12"
		x_vel_min="-40"
		x_vel_max="40"
		y_vel_min="-70"
		y_vel_max="-20"
		gravity.y="0.0"
		count_min="1"
		count_max="2"
		lifetime_min="0.2"
		lifetime_max="0.7"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		airflow_force="1.5"
		airflow_time="1.101"
		airflow_scale="0.05"
		emission_interval_min_frames="1"
		emission_interval_max_frames="2"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="50" >
	</LightComponent>

	<!-- Fans flames, like the vanilla burst of air. -->
	<MagicConvertMaterialComponent
		fan_the_flames="10"
		from_material=""
		to_material=""
		steps_per_frame="20"
		loop="1"
		is_circle="1"
		radius="16" >
	</MagicConvertMaterialComponent>

	<!-- Blows gases (smoke, steam, toxic fumes) out of existence. -->
	<MagicConvertMaterialComponent
		from_material_tag="[gas]"
		to_material="air"
		steps_per_frame="12"
		loop="1"
		is_circle="1"
		radius="30" >
	</MagicConvertMaterialComponent>

	<!-- Pulls in creatures, deflects enemy projectiles, pushes physics objects. -->
	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/whirlwind.lua"
		execute_every_n_frame="2"
		>
	</LuaComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_burst_of_air">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/whirlwind.xml"
		>
	</VariableStorageComponent>

</Entity>
