<!-- Frost Sentinel: an ice crystal that hangs in the air and shoots icicles at nearby enemies. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="6"
			mass="0.04"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.8"
		lob_max="1.0"
		speed_min="140"
		speed_max="140"
		direction_random_rad="0"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="0"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		penetrate_entities="1"
		penetrate_world="1"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		lifetime="480"
		damage="0"
		ragdoll_force_multiplier="0.0"
		hit_particle_force_multiplier="0.0"
		camera_shake_when_shot="0.0"
		bounces_left="0"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_magic_launcher_blue.xml"
		shoot_light_flash_r="10"
		shoot_light_flash_g="140"
		shoot_light_flash_b="255"
		shoot_light_flash_radius="64"
		knockback_force="0.0"
		physics_impulse_coeff="0"
		>
		<!-- Shatters harmlessly when its time is up. -->
		<config_explosion
			never_cache="1"
			damage="0.0"
			camera_shake="0.5"
			explosion_radius="4"
			explosion_sprite="data/particles/explosion_016_plasma.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			spark_material="spark_blue"
			particle_effect="0"
			damage_mortals="0"
			physics_explosion_power.min="0"
			physics_explosion_power.max="0"
			physics_throw_enabled="0"
			shake_vegetation="1"
			sparks_count_min="10"
			sparks_count_max="16"
			sparks_enabled="1"
			material_sparks_enabled="0"
			light_enabled="0"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/frost_sentinel.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Picks a target and fires. -->
	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/frost_sentinel.lua"
		execute_every_n_frame="18"
		>
	</LuaComponent>

	<ParticleEmitterComponent
		emitted_material_name="spark_blue"
		gravity.y="15.0"
		lifetime_min="0.3"
		lifetime_max="0.8"
		count_min="1"
		count_max="1"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		area_circle_radius.min="0"
		area_circle_radius.max="7"
		cosmetic_force_create="0"
		emission_interval_min_frames="2"
		emission_interval_max_frames="5"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="70"
		r="120"
		g="200"
		b="255" >
	</LightComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_arrow">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/frost_sentinel.xml"
		>
	</VariableStorageComponent>

</Entity>
