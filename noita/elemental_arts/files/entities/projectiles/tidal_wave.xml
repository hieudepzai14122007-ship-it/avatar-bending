<!-- Tidal Wave: a rolling wave that sweeps enemies along with it. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="0"
			mass="0.08"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.5"
		lob_max="0.7"
		speed_min="230"
		speed_max="230"
		direction_random_rad="0.00"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		penetrate_entities="1"
		lifetime="70"
		damage="0.2"
		damage_every_x_frames="10"
		velocity_sets_scale="0"
		velocity_sets_rotation="1"
		ragdoll_force_multiplier="0.02"
		hit_particle_force_multiplier="0.2"
		damage_game_effect_entities="data/entities/misc/effect_apply_wet.xml,"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_magic_launcher_large_blue.xml"
		shoot_light_flash_r="60"
		shoot_light_flash_g="150"
		shoot_light_flash_b="255"
		shoot_light_flash_radius="96"
		knockback_force="0.0"
		physics_impulse_coeff="5000"
		>
		<!-- The wave breaks: a shove and a splash, no crater. -->
		<config_explosion
			never_cache="1"
			damage="0.4"
			camera_shake="5"
			explosion_radius="16"
			explosion_sprite="data/particles/explosion_040_poof_blue.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			load_this_entity="mods/elemental_arts/files/entities/projectiles/tidal_orb_splash.xml"
			spark_material="spark_blue"
			particle_effect="0"
			damage_mortals="1"
			physics_explosion_power.min="1.5"
			physics_explosion_power.max="2.2"
			physics_throw_enabled="1"
			shake_vegetation="1"
			sparks_count_min="10"
			sparks_count_max="18"
			sparks_enabled="1"
			material_sparks_enabled="0"
			light_enabled="0"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="0.9"
		image_file="mods/elemental_arts/files/projectiles_gfx/tidal_wave.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Carries enemies along. -->
	<LuaComponent
		script_source_file="mods/elemental_arts/files/scripts/tidal_wave.lua"
		execute_every_n_frame="1"
		>
	</LuaComponent>

	<!-- Real water left in its wake. -->
	<ParticleEmitterComponent
		emitted_material_name="water"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-3"
		x_pos_offset_max="3"
		y_pos_offset_min="-8"
		y_pos_offset_max="8"
		x_vel_min="-15"
		x_vel_max="15"
		y_vel_min="-20"
		y_vel_max="10"
		count_min="2"
		count_max="3"
		lifetime_min="1.0"
		lifetime_max="2.0"
		create_real_particles="1"
		emit_cosmetic_particles="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		delay_frames="4"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- Spray. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_blue"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-3"
		x_pos_offset_max="3"
		y_pos_offset_min="-9"
		y_pos_offset_max="9"
		x_vel_min="-20"
		x_vel_max="20"
		y_vel_min="-40"
		y_vel_max="0"
		gravity.y="80.0"
		count_min="2"
		count_max="3"
		lifetime_min="0.2"
		lifetime_max="0.6"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_bubble">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/tidal_wave.xml"
		>
	</VariableStorageComponent>

</Entity>
