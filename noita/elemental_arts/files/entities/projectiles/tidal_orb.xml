<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="250"
			air_friction="0.4"
			mass="0.08"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.6"
		lob_max="0.8"
		speed_min="280"
		speed_max="330"
		direction_random_rad="0.01"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		die_on_liquid_collision="0"
		lifetime="150"
		lifetime_randomness="5"
		damage="0.4"
		velocity_sets_scale="0"
		velocity_sets_rotation="1"
		ragdoll_force_multiplier="0.02"
		hit_particle_force_multiplier="0.2"
		damage_game_effect_entities="data/entities/misc/effect_apply_wet.xml,"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_magic_launcher_blue.xml"
		shoot_light_flash_r="60"
		shoot_light_flash_g="150"
		shoot_light_flash_b="255"
		shoot_light_flash_radius="72"
		knockback_force="3.0"
		physics_impulse_coeff="3000"
		>
		<!-- The burst: pushes things around but does not dig into terrain. -->
		<config_explosion
			never_cache="1"
			damage="0.6"
			camera_shake="4"
			explosion_radius="18"
			explosion_sprite="data/particles/explosion_040_poof_blue.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			load_this_entity="mods/elemental_arts/files/entities/projectiles/tidal_orb_splash.xml"
			spark_material="spark_blue"
			particle_effect="0"
			damage_mortals="1"
			physics_explosion_power.min="1.2"
			physics_explosion_power.max="1.8"
			physics_throw_enabled="1"
			shake_vegetation="1"
			sparks_count_min="10"
			sparks_count_max="18"
			sparks_enabled="1"
			material_sparks_enabled="0"
			light_enabled="0"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		_enabled="1"
		alpha="1"
		image_file="mods/elemental_arts/files/projectiles_gfx/tidal_orb.xml"
		next_rect_animation=""
		rect_animation=""
		>
	</SpriteComponent>

	<!-- Real water dripping off the orb in flight. -->
	<ParticleEmitterComponent
		emitted_material_name="water"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="-2"
		y_pos_offset_max="2"
		x_vel_min="-10"
		x_vel_max="10"
		y_vel_min="-10"
		y_vel_max="10"
		count_min="1"
		count_max="2"
		lifetime_min="1.0"
		lifetime_max="2.0"
		create_real_particles="1"
		emit_cosmetic_particles="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="2"
		delay_frames="3"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<!-- Cosmetic spray. -->
	<ParticleEmitterComponent
		emitted_material_name="spark_blue"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-3"
		x_pos_offset_max="3"
		y_pos_offset_min="-3"
		y_pos_offset_max="3"
		x_vel_min="-15"
		x_vel_max="15"
		y_vel_min="-15"
		y_vel_max="15"
		gravity.y="60.0"
		count_min="1"
		count_max="2"
		lifetime_min="0.2"
		lifetime_max="0.6"
		is_trail="1"
		trail_gap="2.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		_enabled="1"
		radius="60"
		r="60"
		g="140"
		b="255" >
	</LightComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_bubble">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/elemental_arts/files/entities/projectiles/tidal_orb.xml"
		>
	</VariableStorageComponent>

</Entity>
