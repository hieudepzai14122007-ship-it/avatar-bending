<!-- The shockwave released when an Earthshaker dive lands. It does not hurt the caster. -->
<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			mass="0.04"
			>
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.8"
		lob_max="1.0"
		speed_min="0"
		speed_max="0"
		direction_random_rad="0"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="0"
		die_on_liquid_collision="0"
		die_on_low_velocity="0"
		velocity_sets_scale="0"
		lifetime="2"
		damage="0"
		ragdoll_force_multiplier="0.0"
		hit_particle_force_multiplier="0.0"
		camera_shake_when_shot="0.0"
		bounces_left="0"
		muzzle_flash_file=""
		shoot_light_flash_radius="1"
		knockback_force="0.0"
		physics_impulse_coeff="0"
		penetrate_entities="1"
		penetrate_world="1"
		>
		<!-- Hits hard and throws things about, but leaves the ground intact
		     so the caster is not dropped into a pit of their own making. -->
		<config_explosion
			never_cache="1"
			damage="1.6"
			camera_shake="25"
			explosion_radius="34"
			explosion_sprite="data/particles/explosion_040_poof.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="0"
			hole_destroy_liquid="0"
			hole_enabled="0"
			ray_energy="0"
			spark_material="spark_yellow"
			particle_effect="1"
			damage_mortals="1"
			physics_explosion_power.min="2.0"
			physics_explosion_power.max="3.0"
			physics_throw_enabled="1"
			shake_vegetation="1"
			sparks_count_min="30"
			sparks_count_max="50"
			sparks_enabled="1"
			light_fade_time="0.5"
			stains_enabled="0" >
		</config_explosion>
	</ProjectileComponent>

</Entity>
